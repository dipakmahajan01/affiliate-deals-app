# ---- Build stage ----
FROM node:20-alpine AS build

WORKDIR /app

COPY ./packages ./packages
COPY ./package.json ./package.json
COPY ./pnpm-lock.yaml ./pnpm-lock.yaml
COPY ./pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY ./turbo.json ./turbo.json
COPY ./tsconfig.base.json ./tsconfig.base.json
COPY ./apps/web ./apps/web
RUN npm install -g pnpm
RUN pnpm install
RUN pnpm --filter @deals/web build

# ---- Serve stage ----
# Serves the production build as static files instead of running the Vite dev
# server in production (dev mode was leaking unbundled source and blocking
# meta tags/canonical/JSON-LD/robots.txt/sitemap.xml from ever reaching crawlers).
FROM nginx:1.27-alpine

COPY --from=build /app/apps/web/dist /usr/share/nginx/html
COPY ./docker/nginx.frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
