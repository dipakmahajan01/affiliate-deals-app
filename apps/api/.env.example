MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/deals
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
AMAZON_AFFILIATE_TAG=
FLIPKART_AFFILIATE_ID=
JWT_SECRET=change_me_to_a_long_random_string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
PORT=4000
# AI shopping assistant (DealGenie) — Google Gemini
GEMINI_API_KEY=
# Optional — defaults to gemini-2.5-flash. Use gemini-2.5-pro for max quality or gemini-2.0-flash for cheapest/fastest.
ASSISTANT_MODEL=gemini-2.5-flash
# Email (Gmail SMTP via nodemailer) — welcome email + twice-daily price-drop digest
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=DealDost <no-reply@dealdost.example>
# Base URL of the web app — digest emails link here (product page) instead of straight to the affiliate URL
WEB_APP_URL=http://localhost:3000
